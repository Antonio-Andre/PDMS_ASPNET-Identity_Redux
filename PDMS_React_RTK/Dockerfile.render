FROM node:18-alpine AS build
WORKDIR /app

COPY PDMS_React_RTK/package*.json ./
RUN npm install

COPY PDMS_React_RTK/ .
ARG VITE_DOTNET_URL
ENV VITE_DOTNET_URL=${VITE_DOTNET_URL}
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY PDMS_React_RTK/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]